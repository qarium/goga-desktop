{
  "name": "goga-desktop",
  "version": "0.1.51",
  "private": true,
  "description": "Local Goga pipeline desktop",
  "type": "module",
  "main": "dist-electron/index.cjs",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "package": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir dmg --publish never",
    "format": "prettier --write src tests scripts *.json *.ts",
    "icon:generate": "sh scripts/generate-icon.sh",
    "smoke:host": "node scripts/smoke-host.mjs",
    "smoke:preferences": "npm run build && node scripts/smoke-preferences.mjs",
    "smoke:ui": "npm run build && node scripts/smoke-ui.mjs",
    "test:release": "node --test scripts/tests/*.test.mjs",
    "release:version": "node scripts/release-version.mjs",
    "package:release": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "marked": "18.1.1",
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/osx-sign": "1.3.3",
    "@electron/rebuild": "4.2.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "jsdom": "^27.0.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "local.goga.desktop",
    "productName": "Goga Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "!dist-electron/native/**",
      "!node_modules/node-pty/prebuilds/**",
      "!node_modules/node-pty/build/Debug/**",
      "!node_modules/node-pty/build/Release/obj*/**",
      "!**/[dD][oO][cC][sS]/**"
    ],
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "notarize": false
    },
    "afterPack": "scripts/sign-local.mjs",
    "artifactName": "Goga-Desktop-${version}-${arch}.${ext}",
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "npmRebuild": false,
    "beforePack": "scripts/terminal-before-pack.mjs",
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "dist-electron/native",
        "to": "terminal",
        "filter": [
          "terminal-inspect",
          "manifest.json"
        ]
      }
    ]
  },
  "author": "Goga Desktop",
  "license": "UNLICENSED"
}
